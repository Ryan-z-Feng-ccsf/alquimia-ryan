{
  "nodes": [
    {"id":"document:alquimia/CMakeLists.txt","type":"document","name":"CMakeLists.txt","filePath":"alquimia/CMakeLists.txt","summary":"Defines the core Alquimia library build, conditionally adds PFLOTRAN, CrunchFlow, and ONNX engine sources and dependencies, and installs the library and public headers.","tags":["build-system","configuration","engine-selection","installation"],"complexity":"moderate"},
    {"id":"file:alquimia/alquimia.c","type":"file","name":"alquimia.c","filePath":"alquimia/alquimia.c","summary":"Implements process-wide error and abort callbacks plus formatted version reporting for the public C API.","tags":["error-handling","callback-api","versioning","core-api"],"complexity":"moderate"},
    {"id":"file:alquimia/alquimia.h.in","type":"file","name":"alquimia.h.in","filePath":"alquimia/alquimia.h.in","summary":"CMake-configured public header template exposing version flags, engine availability macros, assertions, error callbacks, abort callbacks, and version output.","tags":["public-api","configuration-template","error-handling","versioning"],"complexity":"moderate"},
    {"id":"file:alquimia/alquimia_containers.F90","type":"file","name":"alquimia_containers.F90","filePath":"alquimia/alquimia_containers.F90","summary":"Defines ISO_C_BINDING-compatible Fortran mirrors of the public Alquimia sizes, state, properties, metadata, status, constraint, and auxiliary-data containers.","tags":["fortran-interop","data-model","type-definition","public-api"],"complexity":"moderate","languageNotes":"The BIND(C) derived types preserve member order and layout so C and Fortran share the same API containers."},
    {"id":"file:alquimia/alquimia_fortran_interface_mod.F90","type":"file","name":"alquimia_fortran_interface_mod.F90","filePath":"alquimia/alquimia_fortran_interface_mod.F90","summary":"Provides an object-oriented Fortran facade over the C Alquimia interface, converting stored C function pointers into callable engine procedures and exposing allocation bindings.","tags":["fortran-interop","adapter","function-pointers","public-api"],"complexity":"complex","languageNotes":"Uses c_f_procpointer to dispatch through a C-compatible function table while presenting type-bound Fortran methods."},
    {"id":"file:alquimia/c_f_interface_module.F90","type":"file","name":"c_f_interface_module.F90","filePath":"alquimia/c_f_interface_module.F90","summary":"Implements reusable C/Fortran string conversions and a case-insensitive Fortran string comparison used by chemistry-engine adapters.","tags":["fortran-interop","string-conversion","utility","iso-c-binding"],"complexity":"moderate"},
    {"id":"file:alquimia/crunch_alquimia_interface.F90","type":"file","name":"crunch_alquimia_interface.F90","filePath":"alquimia/crunch_alquimia_interface.F90","summary":"Implements the full CrunchFlow-backed Alquimia engine lifecycle, constraint processing, operator-split reaction stepping, metadata extraction, and state translation.","tags":["crunchflow","engine-adapter","geochemistry","state-conversion","solver-integration"],"complexity":"complex","languageNotes":"Wraps module-global CrunchFlow state behind a private engine-state pointer and explicit Alquimia-to-engine packing routines."},
    {"id":"file:alquimia/crunch_alquimia_wrappers.F90","type":"file","name":"crunch_alquimia_wrappers.F90","filePath":"alquimia/crunch_alquimia_wrappers.F90","summary":"Exports stable BIND(C) entry points that forward the generic Alquimia engine operations to the CrunchFlow Fortran module despite compiler-specific module symbol mangling.","tags":["crunchflow","fortran-interop","c-bindings","adapter"],"complexity":"moderate"},
    {"id":"service:alquimia/mixed/Makefile","type":"service","name":"Makefile","filePath":"alquimia/mixed/Makefile","summary":"Builds standalone C++/Fortran interoperability experiments for derived types, strings, and pointer-backed structure arrays, with cleanup targets for generated artifacts.","tags":["build-system","mixed-language","fortran-interop","development"],"complexity":"moderate"},
    {"id":"file:alquimia/mixed/README","type":"file","name":"README","filePath":"alquimia/mixed/README","summary":"Briefly identifies the mixed-language directory as a sandbox for C and Fortran interface experiments.","tags":["documentation","mixed-language","sandbox"],"complexity":"simple"},
    {"id":"file:alquimia/mixed/cc-f90-strings.F90","type":"file","name":"cc-f90-strings.F90","filePath":"alquimia/mixed/cc-f90-strings.F90","summary":"Fortran side of a mixed-language string experiment that reverses a fixed-length C-compatible character buffer.","tags":["fortran-interop","string-conversion","example"],"complexity":"simple"},
    {"id":"file:alquimia/mixed/cc-f90-strings.cc","type":"file","name":"cc-f90-strings.cc","filePath":"alquimia/mixed/cc-f90-strings.cc","summary":"C++ driver for testing fixed-buffer string exchange with Fortran, including buffer clearing and invocation of the Fortran reversal routine.","tags":["fortran-interop","string-conversion","example","entry-point"],"complexity":"moderate"},
    {"id":"file:alquimia/mixed/cc-f90-strings.h","type":"file","name":"cc-f90-strings.h","filePath":"alquimia/mixed/cc-f90-strings.h","summary":"Declares shared constants and the external Fortran string-reversal symbol used by the mixed C++/Fortran example.","tags":["fortran-interop","header","type-definition"],"complexity":"simple"},
    {"id":"file:alquimia/mixed/struct-array-pointer.F90","type":"file","name":"struct-array-pointer.F90","filePath":"alquimia/mixed/struct-array-pointer.F90","summary":"Fortran half of an interoperability experiment that maps a C structure array and nested pointer fields, creates output arrays, and writes results back through C pointers.","tags":["fortran-interop","pointer-mapping","structure-array","example"],"complexity":"moderate"},
    {"id":"file:alquimia/mixed/struct-array-pointer.cc","type":"file","name":"struct-array-pointer.cc","filePath":"alquimia/mixed/struct-array-pointer.cc","summary":"C++ half of a C/Fortran structure-array experiment that allocates nested buffers, invokes Fortran processing, prints results, and frees owned memory.","tags":["fortran-interop","memory-management","structure-array","entry-point"],"complexity":"moderate"},
    {"id":"file:alquimia/mixed/struct-derived.F90","type":"file","name":"struct-derived.F90","filePath":"alquimia/mixed/struct-derived.F90","summary":"Fortran routine used to verify layout compatibility by mutating numeric fields in a derived type passed from C++.","tags":["fortran-interop","derived-type","example"],"complexity":"simple"},
    {"id":"file:alquimia/mixed/struct-derived.cc","type":"file","name":"struct-derived.cc","filePath":"alquimia/mixed/struct-derived.cc","summary":"C++ driver that constructs a plain numeric structure, passes it to Fortran for mutation, and prints values before and after the call.","tags":["fortran-interop","derived-type","example","entry-point"],"complexity":"moderate"},
    {"id":"file:alquimia/pflotran_alquimia_interface.F90","type":"file","name":"pflotran_alquimia_interface.F90","filePath":"alquimia/pflotran_alquimia_interface.F90","summary":"Implements the PFLOTRAN-backed Alquimia engine, including setup, conditions, operator-split reaction solves, auxiliary output, metadata, and bidirectional state packing.","tags":["pflotran","engine-adapter","geochemistry","state-conversion","solver-integration"],"complexity":"complex","languageNotes":"Maintains an opaque PFLOTRAN engine state and translates aligned Alquimia containers into PFLOTRAN reaction and auxiliary-variable structures."},
    {"id":"file:alquimia/pflotran_alquimia_wrappers.F90","type":"file","name":"pflotran_alquimia_wrappers.F90","filePath":"alquimia/pflotran_alquimia_wrappers.F90","summary":"Exports stable BIND(C) wrappers for PFLOTRAN-backed setup, shutdown, condition processing, reaction stepping, auxiliary output, and metadata operations.","tags":["pflotran","fortran-interop","c-bindings","adapter"],"complexity":"moderate"},
    {"id":"file:alquimia/pflotran_petsc_stubs.F90","type":"file","name":"pflotran_petsc_stubs.F90","filePath":"alquimia/pflotran_petsc_stubs.F90","summary":"Provides a no-op PETSc logging entry point required when linking the PFLOTRAN adapter in configurations without the full logging implementation.","tags":["pflotran","petsc","linker-stub"],"complexity":"simple"},
    {"id":"document:drivers/CMakeLists.txt","type":"document","name":"CMakeLists.txt","filePath":"drivers/CMakeLists.txt","summary":"Defines and installs the batch-chemistry and one-dimensional reactive-transport driver executables linked against Alquimia.","tags":["build-system","drivers","configuration","installation"],"complexity":"simple"},
    {"id":"document:drivers/LICENSE.inih.txt","type":"document","name":"LICENSE.inih.txt","filePath":"drivers/LICENSE.inih.txt","summary":"Records the BSD license terms for the bundled inih configuration parser used by the driver programs.","tags":["documentation","license","third-party"],"complexity":"simple"},
    {"id":"file:drivers/fpe.c","type":"file","name":"fpe.c","filePath":"drivers/fpe.c","summary":"Implements portable helpers for enabling, disabling, suspending, and restoring floating-point exception trapping across Apple and GNU environments.","tags":["floating-point","error-detection","platform-abstraction","utility"],"complexity":"moderate"},
    {"id":"file:drivers/fpe.h","type":"file","name":"fpe.h","filePath":"drivers/fpe.h","summary":"Declares the driver-facing floating-point exception control API with C++ linkage compatibility.","tags":["floating-point","public-api","header"],"complexity":"simple"},

